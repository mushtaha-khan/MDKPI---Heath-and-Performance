{
  "manifest_version": 3,
  "name": "Dealership Health Monitor",
  "version": "1.0.0",
  "description": "Watch the MyDealerKPI read-only health crawl in real time — every module, screen, tab, and modal as it is verified.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost:5174/*", "http://127.0.0.1:5174/*"],
  "action": {
    "default_title": "Dealership Health Monitor",
    "default_icon": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
  },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" }
}
