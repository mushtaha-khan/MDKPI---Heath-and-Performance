# Copy to .env and fill in. .env is gitignored — never commit real credentials.
KPI_BASE_URL=https://your-tenant.mydealerkpi.com
KPI_USERNAME=
KPI_PASSWORD=

# Role dropdown option labels (exact, as rendered in the PrimeNG select)
KPI_ROLE_AUTOGROUP=AUTOGROUP
KPI_ROLE_DEALER=DEALER

# Screens under comparison
KPI_AUTOGROUP_PATH=/auto-group-v2/service/service-summary
KPI_DMS_PATH=/report/services/dashboard

# Run behaviour
KPI_HEADLESS=true
KPI_NAV_TIMEOUT_MS=90000
